# Copy this file to .env.local and fill in the values.
# Never commit .env.local — only this example file.

# ─────────────────────────────────────────────────────────────
# Email (contact form + shop orders) — sent through Gmail SMTP
# (lib/server/mailer.ts, smtp.gmail.com:465)
#
# How it works:
#   - The site logs into CONTACT_SMTP_USER and sends every email FROM that account.
#   - Contact/order notifications go TO CONTACT_TO_EMAIL (the inbox you actually read).
#   - Confirmation emails go to the customer, and when they hit "Reply",
#     the reply goes to CONTACT_TO_EMAIL.
#   SMTP_USER and TO_EMAIL can be the same address or two different ones.
# ─────────────────────────────────────────────────────────────

# The Gmail address the website sends emails FROM (the account it logs into).
# Example: taistattoos.website@gmail.com
CONTACT_SMTP_USER=

# A Gmail "App Password" for the account above. NOT the normal Gmail password.
# Create it at https://myaccount.google.com/apppasswords (needs 2-Step Verification on).
# It's 16 characters; spaces are fine, the code strips them.
CONTACT_SMTP_PASS=

# The inbox that RECEIVES contact messages and new orders (where you want to read them).
# Also used as the reply-to address on the confirmation emails customers get.
CONTACT_TO_EMAIL=

# ─────────────────────────────────────────────────────────────
# Cloudflare Turnstile — spam/bot protection on the contact and order forms
# Both keys come from the same widget: Cloudflare dashboard → Turnstile → your site.
# ─────────────────────────────────────────────────────────────

# Secret key — used on the server to verify the form wasn't submitted by a bot.
# Keep it private.
TURNSTILE_SECRET_KEY=

# Site key — public, rendered in the browser to show the Turnstile widget.
# (NEXT_PUBLIC_ prefix means it's exposed to the frontend; that's intended.)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─────────────────────────────────────────────────────────────
# GitHub OAuth — lets you log into the CMS admin (Decap) with your GitHub account
# (app/api/auth and app/api/callback). Not in your current .env.local —
# probably only set on the hosting provider. Only needed locally if you
# want to test the CMS login.
# From: GitHub → Settings → Developer settings → OAuth Apps → your app.
# ─────────────────────────────────────────────────────────────

# The OAuth app's Client ID (public).
OAUTH_GITHUB_CLIENT_ID=

# The OAuth app's Client Secret (private).
OAUTH_GITHUB_CLIENT_SECRET=


# --- Upstash Redis (rate limiting for the contact and order forms) -------
# From the database's REST API section. Without them, orders are refused in
# production; the contact form still works but is not rate limited.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Search engine indexing ------------------------------------------------
# Set to "true" ONLY for the Netlify Production deploy context, at launch.
# Anything else (previews, local) sends noindex + a blocking robots.txt.
ALLOW_INDEXING=
